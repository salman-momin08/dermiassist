# ============================================================
# DermiAssist-AI — Environment Variable Template
# ============================================================
# Copy this file to .env (for local dev) or .env.local and fill in real values.
# NEVER commit .env or .env.local to version control.
# In production, set these in Vercel / your CI platform.
# ============================================================

# ── Cloudinary (image uploads) ────────────────────────────
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google AI / Gemini (AI analysis) ─────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GOOGLE_GENAI_API_KEY=

# ── Hugging Face (Open-Source AI Models & Embeddings) ─────
# https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HF_TOKEN=

# ── OpenAI (GPT-4o Clinical Reasoning & Multi-LLM Consensus) ──
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Stream Chat (real-time messaging) ────────────────────
# https://getstream.io/dashboard/
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_API_SECRET=

# ── Supabase (database + auth) ───────────────────────────
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Agora (video calls) ───────────────────────────────────
# https://console.agora.io/
NEXT_PUBLIC_AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ── Upstash Redis (caching + rate limiting) ───────────────
# https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Novu (push notifications) ─────────────────────────────
# https://dashboard.novu.co/
NEXT_PUBLIC_NOVU_APPLICATION_IDENTIFIER=
NOVU_API_SECRET=
NEXT_PUBLIC_NOVU_BACKEND_URL=https://eu.api.novu.co
NEXT_PUBLIC_NOVU_SOCKET_URL=wss://eu.socket.novu.co

# ── FastAPI Microservice URL ──────────────────────────────
FASTAPI_SERVICE_URL=http://localhost:8000

# ── Optional / Internal ───────────────────────────────────
# LOG_LEVEL controls server-side logging verbosity: debug | info | warn | error
LOG_LEVEL=info
